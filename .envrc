use flake
watch_file flake.lock

# Let a git-ignored .envrc.local override the vault/item location first.
[ -f .envrc.local ] && source_env .envrc.local

# GitHub PAT for `gh`, pulled from 1Password at shell-entry — never written to
# disk or the login keychain. Requires the 1Password desktop CLI integration
# ("Integrate with 1Password CLI" in Settings -> Developer).
: "${OP_GH_TOKEN_REF:=op://Private/camris-tools GitHub PAT/credential}"
if has op; then
  if op_out="$(op read --no-newline "$OP_GH_TOKEN_REF" 2>&1)"; then
    export GH_TOKEN="$op_out"
  else
    # Don't fall back silently — a stale global token would look fine but lack
    # this repo's scopes. Surface the real error instead.
    log_error "op read '$OP_GH_TOKEN_REF' failed; gh will use global auth, which"
    log_error "probably lacks this repo's scopes. op said:"
    log_error "  ${op_out}"
  fi
  unset op_out
fi
