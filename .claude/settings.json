{
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(direnv exec . gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-writes.sh\""
          }
        ]
      }
    ]
  }
}
